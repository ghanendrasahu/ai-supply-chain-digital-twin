# Supply Chain Digital Twin configuration
SUPPLY_TWIN_ENV=local
SUPPLY_TWIN_RANDOM_SEED=42
SUPPLY_TWIN_HORIZON_DAYS=90
SUPPLY_TWIN_MONTE_CARLO_RUNS=1000
SUPPLY_TWIN_DEFAULT_SERVICE_LEVEL=0.95
SUPPLY_TWIN_CURRENCY=INR
SUPPLY_TWIN_DATA_DIR=./data
SUPPLY_TWIN_REPORT_DIR=./data/reports

# Logging: LOG_JSON=true emits single-line JSON for aggregators.
SUPPLY_TWIN_LOG_JSON=false
SUPPLY_TWIN_LOG_LEVEL=INFO

# Security: non-empty API_KEYS -> every /api call needs header X-API-Key.
# Env value must be a JSON array, e.g. '["change-me-key", "second-key"]'.
SUPPLY_TWIN_API_KEYS=
# Rate limiting (per client): max requests inside RATE_LIMIT_WINDOW seconds;
# 0 disables. WHAT_IF_MAX_CONCURRENT caps parallel Monte Carlo simulations.
SUPPLY_TWIN_RATE_LIMIT_WINDOW=60
SUPPLY_TWIN_RATE_LIMIT_MAX_REQUESTS=120
SUPPLY_TWIN_WHAT_IF_MAX_CONCURRENT=2
